<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Connect is Android Automotive OS: install only on cars -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Gear (Pleos Vehicle SDK) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- Whether anyone else is in the car, to keep notices quiet (Pleos Vehicle SDK) -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- Spoken notices while driving (Pleos TTS SDK) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- Speech recognition for voice messages, and the microphone for it and for voice calls -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Setting the agreed meeting place as the destination (Pleos NaviHelper) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- Bringing the navigation screen to the front once the route is set -->
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <!-- Matching server -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Trip start and end points, for the driver's life pattern (asked in P, after consent) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Keep recording while navigation is in front -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:name=".DriveMateApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DriveMate">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Runs while driving; the app itself limits driving UI to voice + glanceable info -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <service
            android:name=".trip.RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Demo commands from adb (DebugReceiver). DUMP: only adb shell, not other apps, can send them -->
        <receiver
            android:name=".DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
